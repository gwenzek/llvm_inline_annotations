load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")
load(":defs.bzl", "llvm_inline_annotations")

py_binary(
    name = "analyzer",
    srcs = ["analyzer.py"],
    python_version = "PY3",
)

llvm_inline_annotations(
    name = "llm_report",
    srcs = ["//examples/llm:inspect_srcs"],
    ir = ["//examples/llm:inspect_llvm_ir"],
    tags = ["manual"],
)

py_binary(
    name = "annotate_llm",
    srcs = ["analyzer.py"],
    args = [
        "apply",
        "--report",
        "$(rootpath :llm_report)",
    ],
    data = [":llm_report"],
    main = "analyzer.py",
    tags = ["manual"],
)

py_test(
    name = "test",
    srcs = [
        "analyzer.py",
        "analyzer_test.py",
    ],
    imports = ["."],
    main = "analyzer_test.py",
)
